<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="12dp"
    android:paddingRight="6dp"
    android:minHeight="48dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/key_mapping_spinner_item_choose"
        android:src="@drawable/key_mapping_spinner_item_choose"
        android:contentDescription="@string/default_plan_name"
        android:layout_width="18dp"
        android:layout_height="18dp"/>

    <EditText
        android:layout_weight="1"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:enabled="true"
        android:cursorVisible="true"
        android:background="@null"
        android:id="@+id/key_mapping_spinner_item_text"
        android:textColor="#FFFFFF"
        android:text="预设按键"
        android:textSize="13sp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:ignore="HardcodedText" />


    <ImageView
        android:id="@+id/key_mapping_spinner_item_edit"
        android:src="@drawable/key_mapping_spinner_item_edit"
        android:contentDescription="@string/edit"
        android:padding="6dp"
        android:layout_width="30dp"
        android:layout_height="30dp"/>

    <ImageView
        android:id="@+id/key_mapping_spinner_item_delete"
        android:src="@drawable/key_mapping_spinner_item_delete"
        android:contentDescription="@string/cancel"
        android:padding="6dp"
        android:layout_marginLeft="6dp"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
</LinearLayout>
